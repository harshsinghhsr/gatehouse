{
  "name": "gatehouse",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted control plane for the LiteLLM proxy: issue developers virtual LLM API keys with model access, budgets, and usage visibility, without sharing provider credentials.",
  "keywords": [
    "llm",
    "llm-gateway",
    "litellm",
    "ai-gateway",
    "api-key-management",
    "self-hosted",
    "openai",
    "azure-openai",
    "anthropic",
    "llmops",
    "cost-tracking",
    "rbac",
    "multi-tenant",
    "proxy",
    "openai-compatible"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/harshsinghhsr/gatehouse",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshsinghhsr/gatehouse.git"
  },
  "bugs": {
    "url": "https://github.com/harshsinghhsr/gatehouse/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "./scripts/setup-env.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "zod": "^4.4.3"
  }
}
