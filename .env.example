# Copy to .env — or run ./scripts/setup-env.sh, which writes this file with generated secrets.
# Never commit .env.

# ---------------------------------------------------------------- secrets
# Generate every one of these before you expose anything:  openssl rand -hex 32
POSTGRES_PASSWORD=postgres
# Admin credential for LiteLLM. Backend-only; the browser never sees it.
LITELLM_MASTER_KEY=sk-dev-master-key-change-me
# Encrypts provider credentials inside LiteLLM's database.
# NEVER change this once models exist — stored credentials become undecryptable.
LITELLM_SALT_KEY=dev-only-salt-change-me

# ---------------------------------------------------------------- urls
# Where the dashboard is served. Must be https in production: the session cookie is Secure,
# and the API refuses to boot in production with a plaintext origin.
WEB_ORIGIN=http://localhost:3000
# Where developers point their SDK base_url. This is LiteLLM, not the control plane.
GATEWAY_PUBLIC_URL=http://localhost:4000

# ---------------------------------------------------------------- connections
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/gateway
LITELLM_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/litellm
REDIS_URL=redis://redis:6379
LITELLM_BASE_URL=http://litellm:4000

# ---------------------------------------------------------------- behaviour
# Sign-up is bootstrap-only: it closes itself once the first account exists.
# Set true to reopen it temporarily.
ALLOW_SIGNUP=false
LOG_LEVEL=info
# Reverse proxies in front of the API. The production stack sets this to 1 for its nginx.
# Rate limits key on the client address, so this has to match reality in both directions.
TRUST_PROXY=false

# ---------------------------------------------------------------- provider secrets
# file = a 0600 JSON file on a Docker volume. Plaintext, so it is as private as the host.
# aws  = AWS Secrets Manager.
SECRETS_BACKEND=file
SECRETS_FILE=/tmp/gatehouse-secrets.json

# To exercise the AWS path locally:  docker compose --profile aws up -d localstack
#   SECRETS_BACKEND=aws
#   AWS_ENDPOINT_URL=http://localstack:4566   (http://localhost:4566 from the host)
#   AWS_ACCESS_KEY_ID=test / AWS_SECRET_ACCESS_KEY=test
# In production leave AWS_ENDPOINT_URL and the keys empty and grant the task role access instead.
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
