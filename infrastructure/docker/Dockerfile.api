FROM node:22-alpine
RUN apk add --no-cache openssl curl
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN npm ci --include-workspace-root --workspace @gatehouse/api --workspace @gatehouse/shared

COPY packages/shared packages/shared
COPY apps/api apps/api
COPY infrastructure/docker/api-entrypoint.sh /usr/local/bin/api-entrypoint

# Owned by the unprivileged user so docker-compose.prod.yml can run as `node`. The Prisma client
# is generated at boot rather than at build time, because prisma.config.ts needs DATABASE_URL.
# /data is where the file secret store lives; a fresh named volume inherits this ownership,
# which is what lets the container run as `node` in production.
RUN chmod +x /usr/local/bin/api-entrypoint && mkdir -p /data && chown -R node:node /app /data

EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=3s --start-period=40s --retries=5 \
  CMD curl -fsS http://localhost:3001/health >/dev/null || exit 1
ENTRYPOINT ["api-entrypoint"]
CMD ["npm", "run", "-w", "apps/api", "start"]
